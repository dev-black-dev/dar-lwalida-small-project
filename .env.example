# ─────────────────────────────────────────────────────────────
#  Variables d'environnement — Dar L'Walida
#
#  Copiez ce fichier en `.env` seulement si vous en avez besoin.
#  AUCUNE de ces variables n'est nécessaire pour `npm run build`,
#  pour le site, le panier ou la commande WhatsApp.
#
#  Sur Netlify : Site configuration → Environment variables.
# ─────────────────────────────────────────────────────────────

# URL publique du site (balises Open Graph / canonical).
# Doit inclure le protocole, sans slash final.
# Exemple : https://dar-lwalida.netlify.app
NEXT_PUBLIC_SITE_URL=https://dar-lwalida.netlify.app

# FACULTATIF — uniquement pour drizzle-kit et /api/health.
# Ne jamais committer un vrai mot de passe : `.env` est ignoré par Git.
DATABASE_URL=postgresql://user:password@host:5432/dbname
